[Unit]
Description=exitpool unprivileged SOCKS relay for AWG exit %i
PartOf=exitpool-awg@%i.service

[Service]
Type=simple
NetworkNamespacePath=/run/netns/exitpool-%i
DynamicUser=yes
ExecStart=/opt/exitpool/bin/xray run -c /run/exitpool/%i/relay.json
Restart=on-failure
RestartSec=1
EnvironmentFile=/run/exitpool/%i/memory.env
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryAccounting=yes
MemoryMax=96M
OOMScoreAdjust=500
LimitCORE=0
